<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>RevitMepAutomation</RootNamespace>
    <AssemblyName>RevitMepAutomation</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- Default local Revit API references (adjust Revit version as needed) -->
  <PropertyGroup>
    <RevitVersion>2024</RevitVersion>
    <RevitPath>C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitPath>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(RevitPath)')">
    <Reference Include="RevitAPI">
      <HintPath>$(RevitPath)\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitPath)\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Fallback to NuGet package for Revit API if local installation path is not present -->
  <ItemGroup Condition="!Exists('$(RevitPath)')">
    <PackageReference Include="Autodesk.Revit.SDK" Version="2024.*" PrivateAssets="All" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
