<UserControl x:Class="RevitMepAutomation.Controls.NumericStepper"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="36" d:DesignWidth="180">
    
    <Grid>
        <Border Background="{DynamicResource InputBgBrush}"
                BorderBrush="{DynamicResource InputBorderBrush}"
                BorderThickness="1.5"
                CornerRadius="6"
                Height="32">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>

                <!-- Value Display / Editor -->
                <TextBox x:Name="TxtValue"
                         Grid.Column="0"
                         Text="{Binding FormattedValue, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontFamily="Segoe UI"
                         FontSize="13"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Stretch"
                         TextAlignment="Center"
                         Padding="6,2"
                         LostFocus="TxtValue_LostFocus"
                         KeyDown="TxtValue_KeyDown" />

                <!-- Up / Down Stepper Buttons Column -->
                <Border Grid.Column="1"
                        BorderBrush="{DynamicResource InputBorderBrush}"
                        BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Increment (Up) Button -->
                        <RepeatButton x:Name="BtnUp"
                                      Grid.Row="0"
                                      Click="BtnUp_Click"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Cursor="Hand"
                                      Interval="120"
                                      Delay="300">
                            <RepeatButton.Template>
                                <ControlTemplate TargetType="RepeatButton">
                                    <Border x:Name="btnBg" Background="{TemplateBinding Background}">
                                        <Path Data="M 0 4 L 4 0 L 8 4 Z"
                                              Fill="{DynamicResource AccentPrimaryBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Width="8" Height="4"
                                              Stretch="Uniform" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBg" Property="Background" Value="{DynamicResource CardBgLightBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="btnBg" Property="Background" Value="{DynamicResource SelectionBgBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>

                        <!-- Decrement (Down) Button -->
                        <RepeatButton x:Name="BtnDown"
                                      Grid.Row="1"
                                      Click="BtnDown_Click"
                                      Background="Transparent"
                                      BorderThickness="0,1,0,0"
                                      BorderBrush="{DynamicResource InputBorderBrush}"
                                      Cursor="Hand"
                                      Interval="120"
                                      Delay="300">
                            <RepeatButton.Template>
                                <ControlTemplate TargetType="RepeatButton">
                                    <Border x:Name="btnBg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                        <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                              Fill="{DynamicResource AccentPrimaryBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Width="8" Height="4"
                                              Stretch="Uniform" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBg" Property="Background" Value="{DynamicResource CardBgLightBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="btnBg" Property="Background" Value="{DynamicResource SelectionBgBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
