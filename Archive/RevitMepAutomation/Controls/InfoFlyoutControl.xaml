<UserControl x:Class="RevitMepAutomation.Controls.InfoFlyoutControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="360">

    <Border Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource AccentPrimaryBrush}"
            BorderThickness="1.5"
            CornerRadius="12"
            Padding="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Direction="270" Opacity="0.45" ShadowDepth="6" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28"
                            Background="{DynamicResource AccentPrimaryBrush}"
                            CornerRadius="14"
                            Margin="0,0,10,0">
                        <TextBlock Text="i"
                                   Foreground="#FFFFFF"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   FontFamily="Georgia"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Tool Information &amp; Diagnostics"
                               Style="{DynamicResource WindowTitleTextStyle}"
                               FontSize="15" />
                </StackPanel>

                <!-- Close Button -->
                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Width="26" Height="26"
                        Content="✕"
                        Background="Transparent"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="13"
                        Cursor="Hand"
                        Click="BtnClose_Click" />
            </Grid>

            <!-- Divider -->
            <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource CardBorderBrush}" Margin="0,0,0,14" />

            <!-- Content Area -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,-6,10">
                <StackPanel Margin="0,0,6,0">
                    <!-- About Section -->
                    <TextBlock Text="DAR – CLASH RESOLUTION ENGINE"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentPrimaryBrush}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Version 2.4.0 (Revit 2021–2026 Compatible)"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,12" />

                    <!-- Quick Shortcuts Card -->
                    <Border Background="{DynamicResource CardBgLightBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="⚡ Keyboard Shortcuts"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,6" />
                            <Grid Margin="0,2">
                                <TextBlock Text="Enter" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                <TextBlock Text="Accept &amp; Resolve Clash" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Esc" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                <TextBlock Text="Cancel / Reset Clash" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="↑ / ↓ Arrows" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                <TextBlock Text="Navigate Clash List" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Selected Clash Metadata -->
                    <TextBlock Text="ACTIVE CLASH DETAILS"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentPrimaryBrush}"
                               Margin="0,0,0,6" />

                    <Border Background="{DynamicResource CardBgLightBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10">
                        <StackPanel x:Name="PnlClashDetails">
                            <Grid Margin="0,3">
                                <TextBlock Text="Host Element:" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtHostElement" Text="Cable Tray (ID: 482910)" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Obstacle:" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtObstacle" Text="HVAC Duct (ID: 593021)" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Clash Coordinates:" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtCoordinates" Text="X: 12.4m, Y: 8.2m, Z: 3.5m" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Clearance Safety:" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock x:Name="TxtSafety" Text="✓ Verified (+50mm)" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#22C55E" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer Close Button -->
            <Button Grid.Row="3"
                    Content="Got it"
                    Style="{DynamicResource ModernButtonStyle}"
                    Background="{DynamicResource AccentPrimaryBrush}"
                    Foreground="#FFFFFF"
                    HorizontalAlignment="Right"
                    Padding="20,4"
                    Click="BtnClose_Click" />
        </Grid>
    </Border>
</UserControl>
