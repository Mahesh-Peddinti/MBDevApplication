<UserControl x:Class="RevitMepAutomation.Controls.ClashPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="320" d:DesignWidth="480">
    
    <Grid ClipToBounds="True">
        <!-- Viewport Background Canvas -->
        <Border Background="{DynamicResource PreviewBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <!-- Vector Rendering Canvas -->
                <Canvas x:Name="DrawingCanvas"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        ClipToBounds="True"
                        SizeChanged="DrawingCanvas_SizeChanged"
                        MouseWheel="DrawingCanvas_MouseWheel"
                        MouseDown="DrawingCanvas_MouseDown"
                        MouseMove="DrawingCanvas_MouseMove"
                        MouseUp="DrawingCanvas_MouseUp" />

                <!-- Top Overlay: View Mode Switcher -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="10">
                    <Border Background="#CC1E293B"
                            BorderBrush="#475569"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbIso"
                                         Content="3D Iso"
                                         IsChecked="True"
                                         Checked="ViewMode_Checked"
                                         Style="{x:Null}"
                                         Foreground="#E2E8F0"
                                         FontSize="11"
                                         FontWeight="SemiBold"
                                         Padding="6,3"
                                         Cursor="Hand"
                                         Margin="2,0" />
                            <RadioButton x:Name="RbFront"
                                         Content="Elevation"
                                         Checked="ViewMode_Checked"
                                         Style="{x:Null}"
                                         Foreground="#E2E8F0"
                                         FontSize="11"
                                         FontWeight="SemiBold"
                                         Padding="6,3"
                                         Cursor="Hand"
                                         Margin="2,0" />
                            <RadioButton x:Name="RbTop"
                                         Content="Plan"
                                         Checked="ViewMode_Checked"
                                         Style="{x:Null}"
                                         Foreground="#E2E8F0"
                                         FontSize="11"
                                         FontWeight="SemiBold"
                                         Padding="6,3"
                                         Cursor="Hand"
                                         Margin="2,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Top Right Overlay: Zoom & Reset Controls -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="10">
                    <Border Background="#CC1E293B"
                            BorderBrush="#475569"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnZoomIn"
                                    Content="+"
                                    Width="24" Height="24"
                                    Foreground="#FFFFFF"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontWeight="Bold"
                                    FontSize="14"
                                    Cursor="Hand"
                                    Click="BtnZoomIn_Click"
                                    ToolTip="Zoom In" />
                            <Button x:Name="BtnZoomOut"
                                    Content="-"
                                    Width="24" Height="24"
                                    Foreground="#FFFFFF"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontWeight="Bold"
                                    FontSize="14"
                                    Cursor="Hand"
                                    Click="BtnZoomOut_Click"
                                    ToolTip="Zoom Out" />
                            <Button x:Name="BtnResetView"
                                    Content="⟲"
                                    Width="24" Height="24"
                                    Foreground="#38BDF8"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontWeight="Bold"
                                    FontSize="14"
                                    Cursor="Hand"
                                    Click="BtnResetView_Click"
                                    ToolTip="Reset View" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Bottom Status / Metadata Badge -->
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="10"
                        Background="#CC0F172A"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,4">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot"
                                 Width="8" Height="8"
                                 Fill="#EF4444"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0" />
                        <TextBlock x:Name="TxtStatusBadge"
                                   Text="LIVE PREVIEW"
                                   Foreground="#F8FAFC"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
