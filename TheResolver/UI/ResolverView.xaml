<UserControl x:Class="TheResolver.UI.ResolverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#2C2C2C"
             MinWidth="380">

    <UserControl.Resources>

        <SolidColorBrush x:Key="PanelBrush" Color="#1E1E1E" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4472C4" />

        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EDEDED" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style x:Key="NumberBox" TargetType="TextBox">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="3,2" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>

        <Style x:Key="DirectionRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#EDEDED" />
            <Setter Property="Margin" Value="4" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
        </Style>

    </UserControl.Resources>

    <Grid Margin="6">

        <Grid.RowDefinitions>
            <!-- Title -->
            <RowDefinition Height="Auto" />
            <!-- Model selection -->
            <RowDefinition Height="Auto" />
            <!-- Clash grid: the only row that should absorb spare height -->
            <RowDefinition Height="*" />
            <!-- Detection button -->
            <RowDefinition Height="Auto" />
            <!-- Route preview -->
            <RowDefinition Height="Auto" />
            <!-- Route settings -->
            <RowDefinition Height="Auto" />
            <!-- Status + Finish -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <Border Grid.Row="0" Style="{StaticResource SectionBorder}">

            <TextBlock Text="THE RESOLVER"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />
        </Border>

        <!-- Clash check models -->
        <Border Grid.Row="1"
                Margin="0,4,0,0"
                Style="{StaticResource SectionBorder}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Clash Check Model:"
                           FontWeight="Bold"
                           Style="{StaticResource FieldLabel}" />

                <!-- A ComboBox has no SelectedItem in a multi-tick list, so
                     the closed box would read empty. The overlay supplies the
                     summary text and the replaced ItemContainerStyle keeps the
                     drop-down open while models are ticked. -->
                <Grid Grid.Column="1">

                    <ComboBox x:Name="ModelSelector"
                              ItemsSource="{Binding AvailableModels}"
                              HorizontalAlignment="Stretch"
                              MinHeight="24">

                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ComboBoxItem">
                                            <CheckBox Content="{Binding Name}"
                                                      IsChecked="{Binding IsSelected,
                                                                  Mode=TwoWay,
                                                                  UpdateSourceTrigger=PropertyChanged}"
                                                      Margin="4,3" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ComboBox.ItemContainerStyle>

                    </ComboBox>

                    <TextBlock Text="{Binding ModelSelectionSummary}"
                               Margin="8,0,26,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Foreground="#1A1A1A" />
                </Grid>


            </Grid>
        </Border>

        <!-- Clashes -->
        <DataGrid Grid.Row="2"
                  Margin="0,4,0,0"
                  ItemsSource="{Binding Clashes}"
                  SelectedItem="{Binding SelectedClash}"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#3A3A3A"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  Background="#202020"
                  RowBackground="#242424"
                  AlternatingRowBackground="#2A2A2A"
                  Foreground="#EDEDED"
                  BorderBrush="{StaticResource AccentBrush}"
                  BorderThickness="1">

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Foreground" Value="#EDEDED" />
                    <Setter Property="Padding" Value="4,2" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#4472C4" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#1E1E1E" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Padding" Value="4,3" />
                    <Setter Property="BorderBrush" Value="#3A3A3A" />
                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>

                <!-- Tick column. IsReadOnly on the grid would block the cell
                     checkbox, so this template opts back in. -->
                <DataGridTemplateColumn Width="34" IsReadOnly="False">
                    <DataGridTemplateColumn.Header>
                        <CheckBox IsChecked="{Binding
                                      DataContext.IsAllSelected,
                                      RelativeSource={RelativeSource AncestorType=UserControl},
                                      Mode=TwoWay,
                                      UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Select all clashes" />
                    </DataGridTemplateColumn.Header>

                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected,
                                          Mode=TwoWay,
                                          UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Clash"
                                    Binding="{Binding ClashId}"
                                    Width="1.2*" />

                <DataGridTextColumn Header="Tray"
                                    Binding="{Binding Element1}"
                                    Width="1.4*" />

                <DataGridTextColumn Header="Tray Id"
                                    Binding="{Binding Element1Id}"
                                    Width="1*" />

                <DataGridTextColumn Header="Clashing With"
                                    Binding="{Binding Element2}"
                                    Width="1.4*" />

                <DataGridTextColumn Header="Element Id"
                                    Binding="{Binding Element2Id}"
                                    Width="1*" />

                <DataGridTextColumn Header="Model"
                                    Binding="{Binding Element2ProjectName}"
                                    Width="1.6*" />

                <DataGridTextColumn Header="Status"
                                    Binding="{Binding Status}"
                                    Width="1.2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Foreground"
                                    Value="{Binding StatusColor}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

            </DataGrid.Columns>


        </DataGrid>

        <Button Grid.Row="3"
                Content="Run Clash Detection"
                Margin="0,6,0,0"
                Height="32"
                FontSize="14"
                FontWeight="Bold"
                Background="AntiqueWhite"
                Foreground="Black"
                Command="{Binding RunClashDetectionCommand}" />

        <!-- Route Preview -->
        <Border Grid.Row="4"
                Margin="0,6,0,0"
                Style="{StaticResource SectionBorder}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="190" />
                </Grid.RowDefinitions>

                <TextBlock Text="Route Preview"
                           FontWeight="Bold"
                           Style="{StaticResource FieldLabel}" />

                <Border Grid.Row="1"
                        Background="#161616"
                        BorderBrush="#3A3A3A"
                        BorderThickness="1"
                        Margin="0,3,0,0">

                    <Canvas x:Name="PreviewCanvas"
                            ClipToBounds="True"
                            SizeChanged="PreviewCanvas_SizeChanged" />
                </Border>
            </Grid>
        </Border>

        <!-- Route settings -->
        <Border Grid.Row="5"
                Margin="0,6,0,0"
                Style="{StaticResource SectionBorder}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <GroupBox Header="Route Parameters (mm / degrees)"
                          Foreground="#EDEDED"
                          FontWeight="Bold"
                          BorderBrush="#3A3A3A">

                    <Grid Margin="6,4">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Bend radius (mm)"
                                   Style="{StaticResource FieldLabel}" />

                        <TextBox Grid.Column="1"
                                 Style="{StaticResource NumberBox}"
                                 Text="{Binding BendRadiusMm,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=LostFocus}" />

                        <TextBlock Grid.Row="1"
                                   Text="Bend angle (deg)"
                                   Style="{StaticResource FieldLabel}" />

                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Style="{StaticResource NumberBox}"
                                 Text="{Binding BendAngleDegrees,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=LostFocus}" />

                        <TextBlock Grid.Row="2"
                                   Text="Offset span (mm)"
                                   Style="{StaticResource FieldLabel}" />

                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Style="{StaticResource NumberBox}"
                                 Text="{Binding OffsetSpanMm,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=LostFocus}" />

                        <TextBlock Grid.Row="3"
                                   Text="Clearance (mm)"
                                   Style="{StaticResource FieldLabel}" />

                        <TextBox Grid.Row="3" Grid.Column="1"
                                 Style="{StaticResource NumberBox}"
                                 Text="{Binding TopClearanceMm,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=LostFocus}" />

                    </Grid>
                </GroupBox>


                <StackPanel Grid.Column="1"
                            Margin="8,0,0,0"
                            MinWidth="150">

                    <GroupBox Header="Detour Direction"
                              Foreground="#EDEDED"
                              FontWeight="Bold"
                              BorderBrush="#3A3A3A">

                        <StackPanel Margin="6,4">

                            <RadioButton Content="Auto (from geometry)"
                                         GroupName="Direction"
                                         Style="{StaticResource DirectionRadio}"
                                         IsChecked="{Binding IsDirectionAuto,
                                                     Mode=TwoWay}" />

                            <RadioButton Content="Above the tray"
                                         GroupName="Direction"
                                         Style="{StaticResource DirectionRadio}"
                                         IsChecked="{Binding IsDirectionUp,
                                                     Mode=TwoWay}" />

                            <RadioButton Content="Below the tray"
                                         GroupName="Direction"
                                         Style="{StaticResource DirectionRadio}"
                                         IsChecked="{Binding IsDirectionDown,
                                                     Mode=TwoWay}" />
                        </StackPanel>
                    </GroupBox>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Content="Cancel"
                                Style="{StaticResource ActionButton}"
                                Background="#E67E22"
                                Command="{Binding CancelCommand}"
                                ToolTip="Discard the preview view" />

                        <Button Grid.Column="1"
                                Content="Accept"
                                Style="{StaticResource ActionButton}"
                                Background="#4CAF50"
                                Command="{Binding AcceptCommand}"
                                ToolTip="Reroute every ticked clash" />
                    </Grid>
                </StackPanel>


            </Grid>
        </Border>

        <!-- Status + Finish -->
        <Grid Grid.Row="6" Margin="0,6,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource SectionBorder}"
                    VerticalAlignment="Center">

                <TextBlock Text="{Binding StatusText}"
                           Foreground="#BFD3F2"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StatusText}"
                           VerticalAlignment="Center" />
            </Border>

            <Button Grid.Column="1"
                    Content="FINISH"
                    Width="110"
                    Style="{StaticResource ActionButton}"
                    Background="#44AA22"
                    Command="{Binding FinishCommand}"
                    ToolTip="Clean up preview views and close the pane" />
        </Grid>




    </Grid>


</UserControl>
